# ProjectX Docker Compose configuration.
# Copy to .env  ->  cp .env.docker.example .env

# Host port to expose the server on (container always listens on 3000).
PORT=3000

# Host directory mounted as the workspace (where your git repos live).
WORKSPACE_DIR=./workspace

# Admin account seeded on first run. PASSWORD IS REQUIRED.
PROJECTX_ADMIN_USERNAME=admin
PROJECTX_ADMIN_PASSWORD=

# Optional: leave blank to auto-generate a strong secret on first run.
# Set it (openssl rand -hex 32) to keep logins valid across rebuilds.
JWT_SECRET=

# Optional: public origins for CORS (your Cloudflare tunnel / custom domain),
# comma-separated. Required if you expose the server beyond localhost.
PUBLIC_ORIGINS=

# Optional: Anthropic API key, used as a fallback when the Claude CLI is not
# installed in the container.
ANTHROPIC_API_KEY=
